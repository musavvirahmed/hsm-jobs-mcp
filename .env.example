# Copied/filled by scripts/cloudflare-bootstrap.sh (never commit .env).
PUBLIC_ORIGIN=https://hsmjobs.musavvir.work
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
# Optional: for non-interactive wrangler later. Not a Worker product secret (v1 has no auth).
CLOUDFLARE_API_TOKEN=

# Private release (local operator loop — see README "Local / private release")
# local-d1 = wrangler local persistence; remote-d1 = shared Cloudflare D1 the Worker reads
JOBS_INDEX_TARGET=local-d1
# When JOBS_INDEX_TARGET=remote-d1: skip wrangler d1 migrations apply on each crawl
# (schema already applied). Burst loop sets this after one startup migrate.
# REMOTE_D1_SKIP_MIGRATIONS=1
# Wrangler --persist-to root (project-relative). Default when unset: .wrangler/state
# JOBS_INDEX_LOCAL_D1_STATE=.wrangler/state
# Base URL for private-release:verify and MCP client wiring (wrangler dev default)
PRIVATE_RELEASE_ORIGIN=http://127.0.0.1:8787
# PRIVATE_RELEASE_PORT=8787
# Base URL for shared-release:verify (production full careers pass gate)
# SHARED_RELEASE_ORIGIN=https://hsmjobs.musavvir.work
# hsm-mcp origin for production crawl register load (default: https://hsm.codealan.com)
# HSM_MCP_ORIGIN=https://hsm.codealan.com
